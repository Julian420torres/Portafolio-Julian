---
import ExperienciaItem from "./ExperienciaItem.astro";

const EXPERIENCE = [
  {
    date: "Nov 2023 - Nov 2024",
    title: "Desarrollador Web & QA Tester - ICCS",
    description:
      "Experiencia en desarrollo web con Angular, pruebas funcionales y validación de software. Participación en detección de errores, documentación técnica, soporte y mejora continua de aplicaciones internas.",
    link: "#",
  },

  /*
  {
    date: "March 2022",
    title: "Marketing UI design in Figma",
    description:
      "All of the pages and components are first designed in Figma and we keep a parity between the two versions even as we update the project.",
  },
  {
    date: "April 2022",
    title: "E-Commerce UI code in Tailwind CSS",
    description:
      "Get started with dozens of web components and interactive elements built on top of Tailwind CSS.",
  },
   */
];
---

<ol class="relative border-s border-gray-200 ml-3">
  {
    EXPERIENCE.map((experiencie) => (
      <li class="mb-10 ms-4">
        <ExperienciaItem {...experiencie} />
      </li>
    ))
  }
</ol>
