---
import ThemeToggle from "./ThemeToggle.astro";

const navItems = [
  {
    title: "Experiencia",
    label: "experiencia",
    url: "/#experiencia",
  },
  {
    title: "Proyectos",
    label: "proyectos",
    url: "/#proyectos",
  },
  {
    title: "Sobre mí",
    label: "sobre-mi",
    url: "/#sobre-mi",
  },
  {
    title: "Contacto",
    label: "contacto",
    url: "/#contacto",
  },
];
---

<header
  class="fixed top-0 z-50 flex items-center justify-center w-full mx-auto mt-4"
>
  <nav
    class="header-nav flex gap-x-1 px-4 py-1.5 text-sm font-medium rounded-full justify-center items-center border border-white/10 bg-black/40 backdrop-blur-xl"
  >
    {
      navItems.map((link) => (
        <a
          class="nav-link relative text-xs sm:text-sm block px-3 py-2 rounded-full transition-all duration-300"
          aria-label={link.label}
          href={link.url}
        >
          {link.title}
        </a>
      ))
    }

    <div class="ml-2 pl-2 border-l border-white/10">
      <!-- <ThemeToggle /> -->
    </div>
  </nav>
</header>

<script>
  const sections = document.querySelectorAll("section[id]");
  const navLinks = document.querySelectorAll(".nav-link");

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          // Apaga todos
          navLinks.forEach((link) => {
            link.classList.remove("active");
          });

          // Enciende solo el correspondiente
          const activeLink = document.querySelector(
            `.nav-link[aria-label="${entry.target.id}"]`,
          );

          if (activeLink) {
            activeLink.classList.add("active");
          }
        }
      });
    },
    {
      rootMargin: "-30% 0px -50% 0px",
      threshold: 0,
    },
  );

  sections.forEach((section) => {
    observer.observe(section);
  });
</script>

<style>
  .nav-link {
    color: rgb(209 213 219);
    transition: all 0.3s ease;
  }

  .nav-link:hover {
    color: #53eafd;
  }

  .nav-link.active {
    color: #53eafd;
    background: rgba(83, 234, 253, 0.12);
    box-shadow: 0 0 15px rgba(83, 234, 253, 0.25);
    font-weight: 600;
  }
</style>
