---
import Laravel from "../components/icons/Laravel.astro";
import Php from "../components/icons/Php.astro";
import Bootstrap from "../components/icons/Bootstrap.astro";
import Mysql from "../components/icons/Mysql.astro";

const TAGS = {
  LARAVEL: {
    name: "LARAVEL",
    class: "bg-black text-white",
    icon: Laravel,
  },
  PHP: {
    name: "PHP",
    class: "bg-[#4F5B93] text-white",
    icon: Php,
  },
  BOOSTRAP: {
    name: "BOOSTRAP",
    class: "bg-[#4a0099] text-white",
    icon: Bootstrap,
  },
  MYSQL: {
    name: "MySQL",
    class: "bg-[#00758F] text-white",
    icon: Mysql,
  },
};

const PROJECTS = [
  {
    title: "SISTEMA DE VENTAS PARA EL RESTAURANTE",
  description:
  "Sistema de ventas para restaurante que permite gestionar pedidos, productos, clientes y ventas en tiempo real. Optimiza los procesos administrativos, mejora la organización del negocio y ofrece una interfaz intuitiva para empleados y administradores.",
    link: null,
    github: "https://github.com/Julian420torres/Proyecto-Final",
    image: "/projects/foto_proyecto.webp",
    tags: [TAGS.LARAVEL, TAGS.PHP, TAGS.BOOSTRAP, TAGS.MYSQL],
  },

  {
    title: "PIANOVA",
    description:
      "Aplicación web interactiva para la exploración y visualización de acordes musicales en piano y guitarra. Permite buscar acordes, visualizar sus notas, consultar inversiones, mostrar posiciones en guitarra y gestionar un historial de acordes recientes mediante una interfaz moderna y responsiva.",
    link: "https://pianova-rouge.vercel.app/",
    github: "https://github.com/Julian420torres/Pianova",
    image: "/projects/Proyecto2.webp",
    tags: [],
  },
];
---

<div class="flex flex-col gap-y-20">
  {
    PROJECTS.map(({ image, title, description, tags, link, github }) => (
      <article class="group flex flex-col md:flex-row gap-8 items-center">
        
        <!-- Imagen -->
        <div class="w-full md:w-1/2">
          <div
            class="overflow-hidden rounded-xl border border-white/10
            shadow-xl transition-all duration-300
            group-hover:shadow-purple-500/20"
          >
            <img
              src={image}
              alt={title}
              class="w-full object-cover transition duration-500 group-hover:scale-105"
            />
          </div>
        </div>

        <!-- Información -->
        <div class="w-full md:w-1/2">
          <h3 class="text-3xl font-bold text-white mb-3">
            {title}
          </h3>

          <ul class="flex flex-wrap gap-2 mb-4">
            {tags.map((tag) => (
              <li>
                <span
                  class={`flex items-center gap-2 rounded-full text-xs ${tag.class} py-1 px-3`}
                >
                  <tag.icon class="size-4" />
                  {tag.name}
                </span>
              </li>
            ))}
          </ul>

          <p class="text-gray-300 leading-relaxed mb-6">
            {description}
          </p>

         <div class="flex gap-4">
  <a
    href={github}
    target="_blank"
    class="rounded-xl border border-white/20 px-5 py-2 hover:bg-white/10 transition"
  >
    Code
  </a>

  {link && (
    <a
      href={link}
      target="_blank"
      class="rounded-xl border border-white/20 px-5 py-2 hover:bg-white/10 transition"
    >
      Preview
    </a>
  )}
</div>
        </div>

      </article>
    ))
  }
</div>
