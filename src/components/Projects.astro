---
import Laravel from "../components/icons/Laravel.astro";
import Php from "../components/icons/Php.astro";
import Bootstrap from "../components/icons/Bootstrap.astro";
import Mysql from "../components/icons/Mysql.astro";
import TypeScript from "./icons/TypeScript.astro";
import Astros from "./icons/Astros.astro";
import Tailwind from "./icons/Tailwind.astro";
import LinkButton from "./LinkButton.astro";
import ExternalLink from "./icons/ExternalLink.astro";
import GitHub from "./icons/GitHub.astro";
import projectsData from "@/data/projects.json";

const TAGS: Record<string, { name: string; class: string; icon: any }> = {
  LARAVEL: {
    name: "LARAVEL",
    class: "bg-black text-white",
    icon: Laravel,
  },
  PHP: {
    name: "PHP",
    class: "bg-[#4F5B93] text-white",
    icon: Php,
  },
  BOOSTRAP: {
    name: "BOOSTRAP",
    class: "bg-[#4a0099] text-white",
    icon: Bootstrap,
  },
  MYSQL: {
    name: "MySQL",
    class: "bg-[#00758F] text-white",
    icon: Mysql,
  },
  ASTRO: {
    name: "Astro",
    class: "bg-[#FF5D01] text-white",
    icon: Astros,
  },
  TYPESCRIPT: {
    name: "TypeScript",
    class: "bg-[#3178C6] text-white",
    icon: TypeScript,
  },

  TAILWIND: {
    name: "Tailwind",
    class: "bg-[#06B6D4] text-white",
    icon: Tailwind,
  },
};

const PROJECTS = projectsData.map((project) => ({
  ...project,
  tags: project.tags.map((key) => TAGS[key]),
}));
---

<div class="flex flex-col gap-y-20">
  {
    PROJECTS.map(({ image, title, description, tags, link, github }) => (
      <article class="flex flex-col space-x-0 space-y-6 group md:flex-row md:space-x-10 md:space-y-0">
        {/* Imagen */}
        <div class="w-full md:w-1/2">
          <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition-all duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-[0_20px_60px_-10px_rgba(83,234,253,0.2)] lg:border lg:border-gray-800 lg:hover:border-[#53eafd]/30 lg:hover:bg-gray-800/50">
            <img
              alt={title}
              width="800"
              height="224"
              class="object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105"
              loading="lazy"
              src={image}
            />
            <div
              class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"
              aria-hidden="true"
            />
          </div>
        </div>

        {/* Información */}
        <div class="w-full md:w-1/2">
          <h3 class="text-3xl font-bold text-white mb-3">{title}</h3>

          <ul class="flex flex-wrap gap-2 mb-4">
            {tags.map((tag) => (
              <li>
                <span
                  class={`flex items-center gap-2 rounded-full text-xs ${tag.class} py-1 px-3`}
                >
                  <tag.icon class="size-4" />
                  {tag.name}
                </span>
              </li>
            ))}
          </ul>

          <p class="text-gray-300 leading-relaxed mb-6">{description}</p>

          <footer class="flex items-center mt-4 gap-x-4">
            {github && (
              <LinkButton href={github}>
                <GitHub class="size-5" />
                Code
              </LinkButton>
            )}
            {link && (
              <LinkButton href={link}>
                <ExternalLink class="size-4" />
                Preview
              </LinkButton>
            )}
          </footer>
        </div>
      </article>
    ))
  }
</div>
