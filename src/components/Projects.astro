---
const PROJECTS = [
  {
    title: "SISTEMA DE VENTAS PARA EL RESTAURANTE LA FABRICA",
    description:
      "Sistema de ventas desarrollado para optimizar la gestión administrativa y comercial del restaurante La Fábrica. El proyecto permite administrar pedidos, productos, clientes y ventas en tiempo real, mejorando la organización del negocio y reduciendo errores en los procesos manuales. Además, cuenta con una interfaz intuitiva y dinámica enfocada en brindar una experiencia rápida, eficiente y moderna tanto para empleados como para administradores.",
    link: "https://svgl.app/",
    github: "https://github.com/Julian420torres/Proyecto-Final",
    image: "/projects/foto_proyecto.webp",
    tags: ["HTML", "CSS", "JavaScript"],
  },
];
---

{
  PROJECTS.map(({ image, title, description, tags }) => (
    <article>
      <h3 class="text-2xl font-semibold text-yellow-200 mb-2">{title}</h3>
      <p class="text-lg mb-4 text-pretty">{description}</p>
      <ul>
        {tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
      <img
        class="rounded shadow-2xl shadow-white/10"
        src={image}
        alt={`captura de pantalla del proyecto ${image}`}
      />
    </article>
  ))
}
