---
interface Props {
  title: string;
  company: string;
  description: string;
  date: string;
}

const { title, company, description, date } = Astro.props;
---

<div
  class="relative mx-8 pb-12 grid
  before:absolute
  before:left-[-28px]
  before:block
  before:h-full
  before:border-l-2
  before:border-[#53eafd]/20
  before:content-['']
  md:grid-cols-5
  md:gap-10"
>
  <!-- Punto luminoso -->
  <span
    class="absolute -left-[34px] flex size-[14px] items-center justify-center"
  >
    <span
      class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#53eafd]/30"
    >
    </span>

    <span
      class="relative inline-flex size-[10px] rounded-full bg-[#53eafd] shadow-[0_0_12px_rgba(83,234,253,0.8)]"
    >
    </span>
  </span>

  <!-- Columna izquierda -->
  <div class="relative md:col-span-2 pb-6">
    <div class="sticky top-24">
      <h3 class="text-xl font-bold text-[#53eafd]">
        {title}
      </h3>

      <h4 class="text-lg font-semibold text-white mt-1">
        {company}
      </h4>

      <time class="text-sm text-gray-400">
        {date}
      </time>
    </div>
  </div>

  <!-- Columna derecha -->
  <div class="md:col-span-3 text-gray-300 leading-relaxed text-pretty">
    <p>{description}</p>
  </div>
</div>
