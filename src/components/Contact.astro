<section class="w-full">
  <div
    class="rounded-2xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm"
  >
    <h3 class="text-2xl font-bold text-white mb-2">Contáctame</h3>

    <p class="text-gray-400 mb-6">
      ¿Tienes alguna oportunidad laboral, proyecto o consulta? Puedes enviarme
      un mensaje y te responderé lo antes posible.
    </p>

    <!-- Mensaje de éxito -->
    <div
      id="success-msg"
      class="hidden mb-4 rounded-xl border border-green-500/30 bg-green-500/10 px-4 py-3 text-green-400"
    >
      ✅ ¡Mensaje enviado correctamente! Te responderé pronto.
    </div>

    <!-- Mensaje de error -->
    <div
      id="error-msg"
      class="hidden mb-4 rounded-xl border border-red-500/30 bg-red-500/10 px-4 py-3 text-red-400"
    >
      ❌ Hubo un error al enviar. Inténtalo de nuevo.
    </div>

    <div class="space-y-4">
      <input
        id="name"
        type="text"
        placeholder="Tu nombre"
        required
        class="w-full rounded-xl border border-white/10 bg-black/30 px-4 py-3 text-white outline-none focus:border-blue-500"
      />

      <input
        id="email"
        type="email"
        placeholder="Tu correo electrónico"
        required
        class="w-full rounded-xl border border-white/10 bg-black/30 px-4 py-3 text-white outline-none focus:border-blue-500"
      />

      <input
        id="subject"
        type="text"
        placeholder="Asunto"
        required
        class="w-full rounded-xl border border-white/10 bg-black/30 px-4 py-3 text-white outline-none focus:border-blue-500"
      />

      <textarea
        id="message"
        rows="6"
        placeholder="Escribe tu mensaje..."
        required
        class="w-full rounded-xl border border-white/10 bg-black/30 px-4 py-3 text-white outline-none focus:border-blue-500"
      ></textarea>

      <button
        id="btn-enviar"
        class="rounded-xl border border-white/10 bg-blue-600 px-6 py-3 text-white hover:bg-blue-700 transition"
      >
        Enviar mensaje
      </button>
    </div>
  </div>
</section>

<script>
  import emailjs from "@emailjs/browser";

  emailjs.init("-Knfh7ZktRvcnM_SE");

  document.getElementById("btn-enviar")?.addEventListener("click", async () => {
    const name = (document.getElementById("name") as HTMLInputElement).value;
    const email = (document.getElementById("email") as HTMLInputElement).value;
    const subject = (document.getElementById("subject") as HTMLInputElement)
      .value;
    const message = (document.getElementById("message") as HTMLTextAreaElement)
      .value;

    if (!name || !email || !subject || !message) {
      alert("Por favor completa todos los campos.");
      return;
    }

    const btn = document.getElementById("btn-enviar") as HTMLButtonElement;
    btn.textContent = "Enviando...";
    btn.disabled = true;

    try {
      await emailjs.send("service_gpve15w", "template_hxypvir", {
        name,
        email,
        subject,
        message,
      });

      document.getElementById("success-msg")?.classList.remove("hidden");
      // Limpiar campos
      (document.getElementById("name") as HTMLInputElement).value = "";
      (document.getElementById("email") as HTMLInputElement).value = "";
      (document.getElementById("subject") as HTMLInputElement).value = "";
      (document.getElementById("message") as HTMLTextAreaElement).value = "";
    } catch {
      document.getElementById("error-msg")?.classList.remove("hidden");
    } finally {
      btn.textContent = "Enviar mensaje";
      btn.disabled = false;
    }
  });
</script>
